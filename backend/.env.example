NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cvav
# DATABASE_SSL=true            # pour une base hébergée (Render, Neon, Supabase…)
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-64-caracteres
JWT_EXPIRES_IN=7d
# Code à communiquer aux seuls responsables pour créer leur compte (vide = inscription responsable fermée)
RESPONSABLE_SIGNUP_CODE=
PUBLIC_BASE_URL=http://localhost:3000
PAROISSIALE_MONTANT=1500
# --- Wave : choisir UN des deux modes ---
# 1) API Wave Business (confirmation automatique des paiements)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# 2) Lien marchand Wave (le parent déclare, un responsable confirme)
WAVE_MERCHANT_LINK=
